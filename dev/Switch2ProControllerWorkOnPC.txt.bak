}

# 校准有效性阈值：单个轴行程小于该值时视为没转到位，本次结果不写入本地文件
MIN_VALID_CALIBRATION_RANGE = 0.3

# 行程体检阈值：某个方向比其他方向小太多时给出提醒（不拦截，只警告）
# 例如右方向 0.724、其他方向 0.8 以上，就会提示"向右行程偏小"
